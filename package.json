{
  "name": "sketchroom",
  "version": "1.2.0",
  "private": true,
  "description": "An offline sketchbook for interface ideas",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node tools/serve.cjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.mjs && node --check model.mjs && node --check image-editor.mjs && node --check image-processing.mjs && node --check image-worker.mjs && node --check desktop/main.cjs && node --check desktop/background-worker.cjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.sketchroom.app",
    "productName": "Sketchroom",
    "directories": {
      "output": "release-1.2"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.mjs",
      "model.mjs",
      "text-layout.mjs",
      "image-*.mjs",
      "theme.css",
      "THIRD_PARTY_NOTICES.md",
      "desktop/**/*"
    ],
    "asarUnpack": ["node_modules/@imgly/background-removal-node/dist/**", "node_modules/onnxruntime-node/**", "node_modules/sharp/**", "node_modules/@img/**"],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": { "sharp": "0.35.5", "lodash": "4.18.1", "zod": "3.25.76" },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5"
  }
}
